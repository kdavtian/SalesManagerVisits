{
  "name": "field-visits-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/seed.js",
    "test": "node --test $(find test -name '*.test.js' -not -path 'test/integration/lockdownEngage.test.js') && npm run test:lockdown",
    "test:lockdown": "node --test test/integration/lockdownEngage.test.js",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clean-css": "^5.3.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.12.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
