{
  "name": "field-visits-server",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build:client": "node scripts/build-client.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "lint": "cd .. && eslint --config server/eslint.config.mjs --max-warnings 0 . && node server/scripts/check-imports.mjs",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/seed.js",
    "test": "node --test $(find test -name '*.test.js' -not -path 'test/integration/lockdownEngage.test.js') && npm run test:lockdown",
    "test:lockdown": "node --test test/integration/lockdownEngage.test.js",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:iphone": "playwright test --project=iphone-webkit",
    "audit:ui": "playwright test ui-audit",
    "check:version": "node scripts/check-version-consistency.mjs",
    "find:orphan-uploads": "node scripts/find-orphan-uploads.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "bcryptjs": "^3.0.3",
    "clean-css": "^5.3.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "globals": "^17.13.0"
  }
}
