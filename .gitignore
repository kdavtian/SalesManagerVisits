node_modules/
dist/
build/

# env / secrets
.env
.env.*
!.env.example

# uploaded photos (persisted via Docker volume in prod)
server/uploads/*
!server/uploads/.gitkeep

# logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Playwright E2E suite (server/test/e2e) run artifacts
server/test-results/
server/playwright-report/
server/playwright.local.config.mjs

# Droplet-local deploy state (deploy/deploy.sh's fast/full auto-detection) --
# never meant to be shared across checkouts or committed.
.last-deploy-sha
