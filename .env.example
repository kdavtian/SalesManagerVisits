# Used directly by the Node app when running it locally with `npm run dev`
# (against `docker compose up -d db`).
DATABASE_URL=postgres://fieldvisits:fieldvisits@localhost:5432/fieldvisits
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
UPLOAD_DIR=./uploads
CHECKIN_RADIUS_METERS=200
NODE_ENV=development

# Shared secret the CEO bot's sync script (work/sync_field_visits.py in the
# castrol_ceo_report repo) sends as the X-Sync-Key header when pushing
# debt/order data to POST /api/erp-sync. Leave unset to disable the endpoint.
ERP_SYNC_KEY=change-me-to-a-long-random-string

# Optional: push short alerts (order placed, a plan pending review, a large
# payment collected) straight to Telegram. Leave both unset to disable --
# nothing breaks, notifications are just skipped. TELEGRAM_NOTIFY_CHAT_IDS
# is a comma-separated list of chat IDs to send to (a person's own chat ID,
# or a group's).
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_IDS=

# Used by docker-compose.yml to configure the `db` container and to build
# the `app` container's DATABASE_URL (which points at the `db` service,
# not localhost). Only POSTGRES_PASSWORD needs to be strong in production;
# the others can be left as-is.
POSTGRES_USER=fieldvisits
POSTGRES_PASSWORD=fieldvisits
POSTGRES_DB=fieldvisits
